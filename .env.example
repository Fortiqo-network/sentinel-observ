# sentinel-observ — environment variable reference.
# Copy to .env.local for local development; set the same keys in the Vercel
# project for production. Never commit real values.

# ---------------------------------------------------------------------------
# Scheduler auth (required for /api/cron/*)
# ---------------------------------------------------------------------------

# Shared secret the GitHub Actions scheduler presents as
# "Authorization: Bearer <CRON_SECRET>". Also required by /api/slack/test.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Internal service probing (required to monitor the 5 private services)
# ---------------------------------------------------------------------------

# Public gateway base URL — no trailing slash.
GATEWAY_URL=https://sentinel-api.fortiqo.xyz

# Must match MONITOR_TOKEN in the sentinel-gateway deployment.
# Generate with: openssl rand -hex 32
MONITOR_TOKEN=

# ---------------------------------------------------------------------------
# Slack alerting (docs/03-slack-bot-setup.md)
# ---------------------------------------------------------------------------

# Bot User OAuth Token from the Slack app — starts with xoxb-
SLACK_BOT_TOKEN=

# Channel IDs (look like C0123ABCDEF), not channel names.
SLACK_ALARM_CHANNEL_ID=
# Optional: falls back to the alarm channel when unset.
SLACK_REPORT_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Persistence (required for history, incidents, uptime % and reports)
# ---------------------------------------------------------------------------

# Postgres connection string (Neon free tier works). Schema is created
# automatically on the first tick.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Dashboard access (required — the UI is private)
# ---------------------------------------------------------------------------

# PBKDF2-SHA256 hash of the dashboard password, as pbkdf2:iterations:salt:hash
# (salt and hash base64). The plaintext password is never stored anywhere.
# Unset = fails closed: the login page reports it is unconfigured and nobody
# gets in. Note the ':' separators — '$' would be mangled by dotenv expansion.
#
# Generate a new one with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);const i=210000;console.log('pbkdf2:'+i+':'+s.toString('base64')+':'+c.pbkdf2Sync(process.argv[1],s,i,32,'sha256').toString('base64'))" 'your-password'
DASHBOARD_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Traffic ingest (required for the /analytics page)
# ---------------------------------------------------------------------------

# Shared secret sentinel-frontend's edge middleware presents as X-Ingest-Token
# on POST /api/ingest/pageview. Must match OBSERV_INGEST_TOKEN in the
# sentinel-frontend deployment. Generate with: openssl rand -hex 32
INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Presentation (optional)
# ---------------------------------------------------------------------------

# Public URL of this dashboard; when set, Slack alerts link back to it.
DASHBOARD_URL=https://monitor.fortiqo.xyz
